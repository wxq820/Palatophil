.container { padding: 24rpx; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.subtitle { font-size: 26rpx; color: #888; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.field { width: 100%; padding: 16rpx; background: #f7f7f7; border-radius: 8rpx; font-size: 28rpx; box-sizing: border-box; }
.btn-primary { background: #06ae56; color: #fff; border-radius: 12rpx; padding: 20rpx 0; text-align: center; font-weight: 500; }
.btn-danger { background: #ee0a24; color: #fff; border-radius: 12rpx; padding: 16rpx 0; text-align: center; font-size: 26rpx; }
.btn-secondary { background: #fff; color: #06ae56; border: 2rpx solid #06ae56; border-radius: 12rpx; padding: 18rpx 0; text-align: center; }
.ingredient-item { display: flex; gap: 8rpx; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.ingredient-item .name { flex: 1; }
.ingredient-item .amount { width: 140rpx; }
.tag-pill { padding: 6rpx 16rpx; background: #06ae56; color: #fff; border-radius: 16rpx; font-size: 22rpx; }
.picker { padding: 16rpx; background: #f7f7f7; border-radius: 8rpx; }
